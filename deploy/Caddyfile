# Caddy держит HTTPS и проксирует всё в приложение.
#
# ⭐ Сертификат выпускается и продлевается сам — ради этого Caddy здесь и стоит.
# HTTPS не украшение: без него не работают ни push-уведомления, ни установка PWA
# на телефон, то есть половина игры.

# ⭐ Доменов может быть несколько: игра переезжала, а старые ссылки продолжают ходить
# по рукам. Caddy выпустит сертификат на каждый сам. Переменная — список через пробел;
# если её не задали, работает один домен, как раньше.
{$BARDAK_DOMAINS} {
	encode zstd gzip

	# ⭐ WebSocket проходит через reverse_proxy без единой настройки: Caddy сам
	# пропускает Upgrade. Отдельный блок для /ws заводить не нужно.
	reverse_proxy app:8088 {
		# ⚠️ Реальный адрес игрока нужен пределу частоты: без него весь прод
		# считался бы одним клиентом, и предел выключился бы там, где он и нужен.
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}

# ⭐ Соседнее приложение на этом же сервере — Agent Room (репозиторий agent-room-v,
# свой compose-проект `agent-room`). Его контейнер подключён к сети bardak_default
# под алиасом `agent-room`, поэтому Caddy видит его по имени.
# ⚠️ Блок живёт здесь, а не только на сервере: ship.sh синхронизирует deploy/ с
# --delete и стёр бы правку, сделанную руками на машине.
agent-room.shabahost.space {
	encode zstd gzip

	reverse_proxy agent-room:8000 {
		header_up X-Forwarded-For {remote_host}
		# room_listen держит один MCP-запрос открытым до 240 с (LISTEN_MAX_MS).
		flush_interval -1
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}
