# Настройки прода. Скопировать в deploy/.env и заполнить.
#
# ⚠️ deploy/.env В РЕПОЗИТОРИЙ НЕ КЛАДЁТСЯ (см. .gitignore): здесь секреты.

# Домен, на который смотрит A-запись сервера. Caddy выпустит по нему сертификат.
BARDAK_DOMAIN=bardak.example.com

# Пароль базы. Любая длинная случайная строка: наружу база не торчит,
# но и внутри сети пароль из примера — плохая идея.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ⚠️ Подпись токенов. Не меньше 32 байт, иначе сервер не стартует.
# Сменить его — значит разлогинить всех разом.
#   openssl rand -base64 48
BARDAK_JWT_SECRET=

# ⚠️ Код приглашения. Клуб закрытый: без своего кода зарегистрируется кто угодно,
# потому что умолчание лежит в открытом репозитории. Через запятую можно несколько.
BARDAK_INVITE_CODES=

# Кто вправе закрывать сезоны рейтинга (идентификаторы через запятую). Пусто — никто.
BARDAK_SEASON_ADMINS=

# Push-уведомления «твой ход». Без ключей просто выключены — игра работает.
#   docker run --rm node:20-alpine node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('private:',k.privateKey.export({format:'jwk'}).d);console.log('public:',Buffer.concat([Buffer.from([4]),Buffer.from(k.publicKey.export({format:'jwk'}).x,'base64url'),Buffer.from(k.publicKey.export({format:'jwk'}).y,'base64url')]).toString('base64url'))"
BARDAK_VAPID_PUBLIC=
BARDAK_VAPID_PRIVATE=
BARDAK_VAPID_SUBJECT=mailto:admin@bardak.example.com

# Ходить ли за игрока по истечении времени хода. По умолчанию — нет: стол просто ждёт.
BARDAK_AUTO_MOVE=false

# Версия образа. Ставится deploy.sh; вручную нужна только для отката.
BARDAK_VERSION=latest

# ── бэкапы (deploy/backup.sh) ───────────────────────────────────────────────
# S3-совместимое хранилище. Пусто — бэкап только на диск сервера,
# а бэкап, лежащий рядом с базой, от потери сервера не спасает.
BARDAK_BACKUP_BUCKET=
BARDAK_BACKUP_RETENTION_DAYS=14
